@model SolicitacaoFormularioViewModel
@{
    ViewData["Title"] = "Nova solicitação";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-3">Nova solicitação de crédito</h1>
        <p class="text-secondary">A API aceita valores entre R$ 100,00 e R$ 10.000,00. A solicitação inicia com status Em análise.</p>

        <form asp-action="Criar" method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="ClienteId" class="form-label"></label>
                <input asp-for="ClienteId" class="form-control" />
                <span asp-validation-for="ClienteId" class="text-danger"></span>
                <div class="form-text">
                    <a asp-controller="Clientes" asp-action="Consultar">Consultar um cliente</a> para copiar o identificador.
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ValorSolicitado" class="form-label"></label>
                <input asp-for="ValorSolicitado" class="form-control" type="number" min="100" max="10000" step="0.01" />
                <span asp-validation-for="ValorSolicitado" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Registrar solicitação</button>
        </form>
    </div>
</div>
