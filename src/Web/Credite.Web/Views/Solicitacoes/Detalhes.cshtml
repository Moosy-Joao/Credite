@model SolicitacaoApiDto
@using System.Globalization
@{
    ViewData["Title"] = "Detalhes da solicitação";
}

<h1 class="h3 mb-3">Detalhes da solicitação</h1>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Solicitação</span>
        <span class="badge text-bg-warning">@(Model.Status == "EmAnalise" ? "Em análise" : Model.Status)</span>
    </div>
    <dl class="card-body row mb-0">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9 text-break">@Model.Id</dd>
        <dt class="col-sm-3">ID do cliente</dt>
        <dd class="col-sm-9 text-break">@Model.ClienteId</dd>
        <dt class="col-sm-3">Valor solicitado</dt>
        <dd class="col-sm-9">@Model.ValorSolicitado.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.Status == "EmAnalise" ? "Em análise" : Model.Status)</dd>
        <dt class="col-sm-3">Criado em</dt>
        <dd class="col-sm-9">@Model.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à listagem</a>
    <a asp-controller="Clientes" asp-action="Consultar" asp-route-id="@Model.ClienteId"
       class="btn btn-outline-primary">Consultar cliente</a>
</div>
